# Copy this file to .env and fill in your own values. Never commit .env.

# Google Gemini API key. Leave blank to run in Demo Mode (local fallback AI).
GEMINI_API_KEY=

# Force demo mode even if a Gemini key is present (true/false).
DEMO_MODE=false

# UI/movie defaults
DEFAULT_LANGUAGE=en
DEFAULT_MOVIE_STYLE=cinematic
DEFAULT_ASPECT_RATIO=16:9
DEFAULT_QUALITY=high
NARRATION_ENABLED_DEFAULT=true

# Upload limits
MAX_UPLOAD_MB=500

# Logging
LOG_LEVEL=INFO

# Change this in any real deployment.
SECRET_KEY=dev-secret-change-me
